# Database
DATABASE_URL=postgresql://archon:app@localhost:5432/{{snake projectName}}
# Schema is managed by versioned migrations: `npm run db:migrate`.
# Set DB_SYNCHRONIZE=true ONLY for throwaway local dev to let TypeORM auto-sync.
DB_SYNCHRONIZE=false

{{#if hasRedis}}
REDIS_HOST=localhost
REDIS_PORT=6379
{{/if}}

# JWT verification
#JWT_ISSUER={{jwtIssuer}}
#JWT_AUDIENCE={{jwtAudience}}

# Choose ONE verification mode:

# (A) RS256 / OIDC providers (recommended)
#JWT_JWKS_URI={{jwtJwksUri}}

# (B) HS256 shared secret (simple internal use)
JWT_SECRET={{jwti}}

# Port
PORT=3000