NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# CORS
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Database (compose service hostname = db)
DATABASE_URL=postgresql://archon:app@db:5432/{{snake projectName}}?schema=public

# Optional for hosted Postgres
# DATABASE_SSL=false

# Optional body size knob
MAX_BODY_SIZE=1mb

# Redis
REDIS_HOST=redis
REDIS_PORT=6379