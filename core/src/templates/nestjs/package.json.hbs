{
"name": "{{kebab projectName}}",
"version": "0.0.1",
"description": "",
"author": "",
"private": true,
"license": "UNLICENSED",
"scripts": {
"build": "nest build",
"format": "prettier --write \"src/**/*.ts\"",
"start": "nest start",
"start:dev": "nest start --watch",
"start:debug": "nest start --debug --watch",
"start:prod": "node {{#if platform.newRelic}}-r newrelic {{/if}}dist/main",
"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
"test": "jest",
"test:watch": "jest --watch",
"test:cov": "jest --coverage",
"db:migrate": "ts-node scripts/db-migrate.ts"{{#if platform.husky}},
"prepare": "if [ \"$NODE_ENV\" != \"production\" ]; then husky; fi"{{/if}}
},
"jest": {
"moduleFileExtensions": ["js", "json", "ts"],
"rootDir": "src",
"setupFiles": ["<rootDir>/test-setup.ts"],
"testRegex": ".*\\.spec\\.ts$",
"transform": { "^.+\\.(t|j)s$": "ts-jest" },
"collectCoverageFrom": ["**/*.(t|j)s"],
"coveragePathIgnorePatterns": ["\\.module\\.ts$", "main\\.ts$", "\\.entity\\.ts$", "\\.dto\\.ts$"],
"coverageDirectory": "../coverage",
"coverageReporters": ["text", "lcov"],
"testEnvironment": "node"
},
"dependencies": {
"@nestjs/common": "^10.4.0",
"@nestjs/core": "^10.4.0",
"@nestjs/platform-express": "^10.4.0",
"@nestjs/swagger": "^7.4.0",
"swagger-ui-express": "^5.0.0",
"@nestjs/typeorm": "^10.0.0",
"@nestjs/config": "^3.0.0",
"typeorm": "^0.3.0",
"pg": "^8.0.0",
"class-validator": "^0.14.0",
"class-transformer": "^0.5.0",
"jose": "^5.0.0",
"reflect-metadata": "^0.1.13",
"rxjs": "^7.8.1",
"joi": "^17.11.0",
"nestjs-pino": "^4.0.0",
"pino-pretty": "^10.2.3",
"pino-http": "^9.0.0",
"helmet": "^7.1.0",
"cookie-parser": "^1.4.6",
"@nestjs/throttler": "^5.0.0",
"uuid": "^9.0.1",
"pg-promise": "^11.5.0"{{#if hasRedis}},
"ioredis": "^5.3.2"{{/if}}{{#if hasQueue}},
"bullmq": "^5.8.0",
"@nestjs/bullmq": "^10.1.1"{{/if}}{{#if enableOutbox}},
"@nestjs/schedule": "^4.1.0"{{/if}}{{#if platform.newRelic}},
"newrelic": "^12.13.0"{{/if}}
},
"devDependencies": {
"@nestjs/cli": "^10.0.0",
"@nestjs/schematics": "^10.0.0",
"@nestjs/testing": "^10.0.0",
"@types/express": "^4.17.17",
"@types/jest": "^29.5.2",
"@types/node": "^20.3.1",
"@types/supertest": "^2.0.12",
"@types/cookie-parser": "^1.4.3",
"@types/uuid": "^9.0.2",
"@typescript-eslint/eslint-plugin": "^7.0.0",
"@typescript-eslint/parser": "^7.0.0",
"eslint": "^8.57.0",
"eslint-config-airbnb-typescript": "^18.0.0",
"eslint-config-prettier": "^9.1.0",
"eslint-plugin-import": "^2.29.1",
"eslint-plugin-prettier": "^5.1.3",
"eslint-plugin-unused-imports": "^3.1.0",
"jest": "^29.7.0",
"prettier": "^3.2.5",
"source-map-support": "^0.5.21",
"supertest": "^7.0.0",
"ts-jest": "^29.1.2",
"ts-loader": "^9.5.1",
"ts-node": "^10.9.2",
"tsconfig-paths": "^4.2.0",
"typescript": "~5.4.5"{{#if platform.husky}},
"husky": "^9.0.11"{{/if}}
}
}