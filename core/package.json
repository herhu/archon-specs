{
    "name": "archon-core",
    "version": "1.0.0",
    "description": "System Architect CLI",
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "bin": {
        "archon": "bin/archon.ts"
    },
    "scripts": {
        "build": "rm -rf dist && tsc && cp -r src/templates dist/src/",
        "start": "ts-node bin/archon.ts",
        "test": "vitest run",
        "smoke": "npm run build && node scripts/smoke-generate.cjs",
        "benchmark": "npx ts-node scripts/benchmark.ts",
        "benchmark:scaling": "npx ts-node scripts/benchmark-scaling.ts",
        "benchmark:all": "npx ts-node scripts/benchmark.ts && npx ts-node scripts/benchmark-scaling.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "ajv": "^8.12.0",
        "chalk": "^4.1.2",
        "commander": "^11.1.0",
        "dotenv": "^16.3.1",
        "fs-extra": "^11.2.0",
        "handlebars": "^4.7.8",
        "handlebars-helpers": "^0.10.0",
        "inquirer": "^9.2.12",
        "jose": "^5.2.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "ts-morph": "^28.0.0",
        "uml-mcp": "file:../servers/uml",
        "uuid": "^14.0.0",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/inquirer": "^9.0.7",
        "@types/node": "^20.10.6",
        "@types/pino": "^7.0.4",
        "@types/uuid": "^10.0.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3",
        "vitest": "^4.0.18"
    }
}
